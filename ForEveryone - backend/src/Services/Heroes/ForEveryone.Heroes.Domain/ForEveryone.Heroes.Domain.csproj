<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- `LocalizedText` vive en el SharedKernel: los textos que ve el jugador los
         decide el cliente, y el dominio solo aporta la clave y los argumentos. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\ForEveryone.SharedKernel\ForEveryone.SharedKernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure necesita leer el detalle de mapeo interno (por ejemplo la
         columna donde Battle guarda la secuencia de acciones) sin que eso pase
         a formar parte del contrato publico del dominio. -->
    <InternalsVisibleTo Include="ForEveryone.Heroes.Infrastructure" />
  </ItemGroup>

</Project>
