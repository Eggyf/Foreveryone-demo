<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los cuatro servicios usan MediatR 14.2.0. El SharedKernel queda
         tambien en 14.2.0 porque es la raiz del grafo: si se quedara en una
         version menor, un restore limpio resolveria la mayor para todo el
         grafo y las APIs que compilaron contra la anterior fallarian al
         arrancar. -->
    <PackageReference Include="MediatR" Version="14.2.0" />
  </ItemGroup>

</Project>
