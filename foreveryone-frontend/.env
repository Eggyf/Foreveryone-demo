# URLs base de cada microservicio. Vite solo expone al navegador las variables
# con prefijo VITE_, asi que el prefijo es obligatorio.
#
# Los valores de abajo son los puertos que levanta `start-all.ps1`. Para
# apuntar a otro despliegue (por ejemplo un entorno remoto) cambia solo el
# valor: el resto del frontend lee estas variables desde `src/api/api.ts`.
VITE_IDENTITY_URL=http://localhost:5045
VITE_HEROES_URL=http://localhost:5281
VITE_KINGDOM_URL=http://localhost:5256
VITE_SHOP_URL=http://localhost:5136
